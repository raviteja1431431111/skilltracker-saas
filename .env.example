# SkillTracker Environment Variables Blueprint

# Environment Mode: 'development', 'testing', or 'production'
FLASK_ENV=production

# Application Secret Key (Required for session cookie encryption)
SECRET_KEY=replace-with-a-secure-random-secret-key

# HTTP Port (Defaults to 5000 if not set)
PORT=5000

# Database URL
# For local SQLite development, leave blank or omit.
# For production PostgreSQL (Railway / Render), set:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Secure Cookies (Set to True when running over HTTPS in production)
SESSION_COOKIE_SECURE=False
